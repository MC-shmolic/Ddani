@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager
@using Models

@page "/createcharacter"

<div class="cc-page">

    <h2 class="cc-title">Create Character</h2>

    <div class="cc-name">
        <label for="cc-name-input">Character name</label>
        <input id="cc-name-input" type="text" placeholder="Enter a name" @bind="characterName" @bind:event="oninput" />
    </div>

    <div class="cc-classes">
        @foreach (var c in classes)
        {
            <div class="cc-class @(selectedClass == c.Name ? "selected" : "")">
                <div class="cc-l1">
                    <div class="cc-l2">
                        <div class="cc-l3">
                            <div class="cc-art" style="--art: url('resources/@c.Image')">

                                <div class="cc-banner">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)c.Icon)</svg>
                                </div>

                                <div class="cc-info">
                                    <h3>@c.Name</h3>

                                    <div class="cc-tags">
                                        <span>@c.Tag</span>
                                        <span>@c.Ability</span>
                                    </div>

                                    <p>@c.Description</p>
                                </div>

                                <div class="cc-footer">
                                    <span class="cc-source">Player's Handbook</span>

                                    <div class="cc-buttons">
                                        <a class="cc-learn" href="@c.LearnUrl" target="_blank" rel="noopener">Learn more</a>

                                        <button type="button" class="cc-select" aria-pressed="@(selectedClass == c.Name)"
                                                @onclick="() => selectedClass = c.Name">
                                            <span>@(selectedClass == c.Name ? "Selected" : "Select")</span>
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="cc-actions">
        <button class="cc-create" @onclick="CreateCharacter1">Create</button>
        <p class="cc-message">@message</p>
    </div>

</div>

@code {
    HttpClient Http = new HttpClient();

    // Paste your API string here
    string api = "https://localhost:7105/api/CharactersDB/InsertCharacter";

    string characterName = "";
    string selectedClass = "";
    string message = "";

    int userID = -1;

    // Image = file name inside wwwroot/resources (add your own art there)
    record ClassInfo(string Name, string Tag, string Ability, string Description, string Image, string LearnUrl, string Icon);

    List<ClassInfo> classes = new()
    {
        new("Rogue", "Dexterous Expert", "Dexterity",
            "Rogues rely on cunning, stealth, and their foes' vulnerabilities to get the upper hand in any situation.",
            "rogue.jpg", "https://www.dndbeyond.com/classes/rogue",
            "<path d='M5 5 L19 19 M19 5 L5 19 M4 8 L8 4 M16 4 L20 8'/>"),

        new("Warrior", "Weapon Master", "Strength",
            "Warriors lead the charge, take the hits, and master every weapon and armor on the battlefield.",
            "warrior.jpg", "https://www.dndbeyond.com/classes/fighter",
            "<path d='M12 3 L12 17 M7 13 L17 13 M12 17 L12 21'/>"),

        new("Priest", "Divine Healer", "Wisdom",
            "Priests channel divine power to heal their allies, shield them from harm, and smite the wicked.",
            "priest.jpg", "https://www.dndbeyond.com/classes/cleric",
            "<path d='M12 3 L12 21 M6 9 L18 9'/><circle cx='12' cy='12' r='9'/>"),

        new("Mage", "Arcane Scholar", "Intelligence",
            "Mages study the arcane and bend fire, frost, and lightning to their will.",
            "mage.jpg", "https://www.dndbeyond.com/classes/wizard",
            "<path d='M12 3 L14.5 9.5 L21 10 L16 14.5 L17.5 21 L12 17.5 L6.5 21 L8 14.5 L3 10 L9.5 9.5 Z'/>")
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var data = await MySession.GetAsync<string[]>("data");

            if (!data.Success || data.Value == null)
            {
                navigationManager.NavigateTo("/login");
                return;
            }

            userID = int.Parse(data.Value[0]);

            StateHasChanged();
        }
    }


    private async Task CreateCharacter1()
    {
        if (string.IsNullOrWhiteSpace(characterName))
        {
            message = "Enter a name for your character.";
            return;
        }

        if (selectedClass == "")
        {
            message = "Choose a class.";
            return;
        }

        var character = new
        {
            UserID = userID, 
            CharacterName = characterName,
            Lvl = 1,
            Class = selectedClass,
            Money = 0,
            Multiplier = 1
        };

        try
        {
            var response = await Http.PostAsJsonAsync(api, character);

            if (response.IsSuccessStatusCode)
            {
                message = $"{characterName} the {selectedClass} was created!";
                navigationManager.NavigateTo("/");
            }
            else
            {
                message = $"Error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            message = $"Request failed: {ex.Message}";
        }
    }
}

@* ===== DESIGN: delete this whole style block to remove the styling ===== *@
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto+Condensed:wght@400;700&family=Roboto:wght@400;500&display=swap');

    .cc-page {
        --cc-bg: #1d1e20;
        --cc-panel: #2b2d31;
        --cc-border: #3d4045;
        --cc-red: #c53131;
        --cc-red-dark: #9e2424;
        --cc-gold: #d9b45f;
        --cc-navy: #0c0f1f;
        --cc-blue: #2a56b8;
        --cc-text: #e8e8e8;
        --cc-muted: #a3a6ab;
        min-height: 100vh;
        padding: 40px 5vw 60px;
        background: var(--cc-bg);
        color: var(--cc-text);
        font-family: 'Roboto', Arial, sans-serif;
        box-sizing: border-box;
    }

    .cc-title {
        max-width: 820px;
        margin: 0 auto 30px;
        padding-bottom: 12px;
        border-bottom: 3px solid var(--cc-red);
        font-family: 'Roboto Condensed', Arial, sans-serif;
        font-weight: 700;
        font-size: 2rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Name */
    .cc-name {
        max-width: 420px;
        margin: 0 auto 36px;
    }

        .cc-name label {
            display: block;
            margin-bottom: 8px;
            font-family: 'Roboto Condensed', Arial, sans-serif;
            font-weight: 700;
            color: var(--cc-muted);
        }

        .cc-name input {
            width: 100%;
            padding: 12px 14px;
            box-sizing: border-box;
            background: var(--cc-panel);
            color: var(--cc-text);
            border: 1px solid var(--cc-border);
            border-radius: 4px;
            font-size: 1rem;
        }

            .cc-name input:focus {
                outline: none;
                border-color: var(--cc-red);
            }

    /* Class cards */
    .cc-classes {
        max-width: 820px;
        margin: 0 auto;
        display: grid;
        gap: 28px;
    }

    .cc-class {
        transition: filter 0.2s;
    }

        .cc-class.selected {
            filter: drop-shadow(0 0 10px rgba(217, 180, 95, 0.55));
        }

    /* Gold double frame with cut corners */
    .cc-l1, .cc-l2, .cc-l3, .cc-art {
        clip-path: polygon(var(--c) 0, calc(100% - var(--c)) 0, 100% var(--c), 100% calc(100% - var(--c)), calc(100% - var(--c)) 100%, var(--c) 100%, 0 calc(100% - var(--c)), 0 var(--c));
    }

    .cc-l1 {
        --c: 40px;
        background: var(--cc-gold);
        padding: 2px;
    }

    .cc-l2 {
        --c: 33px;
        background: var(--cc-navy);
        padding: 5px;
    }

    .cc-l3 {
        --c: 16px;
        background: var(--cc-gold);
        padding: 1px;
    }

    .cc-art {
        --c: 13px;
        position: relative;
        min-height: 340px;
        padding: 28px 32px 24px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        background-color: #1b2142;
        background-image: linear-gradient(90deg, rgba(8, 10, 25, 0.95) 0%, rgba(8, 10, 25, 0.7) 50%, rgba(8, 10, 25, 0.1) 100%), linear-gradient(0deg, rgba(8, 10, 25, 0.9) 0%, rgba(8, 10, 25, 0) 55%), var(--art);
        background-size: cover;
        background-position: right center;
    }

    /* Banner with class emblem */
    .cc-banner {
        position: absolute;
        top: 0;
        left: 34px;
        width: 56px;
        height: 78px;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 14px;
        box-sizing: border-box;
        background: #123a86;
        clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);
    }

        .cc-banner svg {
            width: 32px;
            height: 32px;
            fill: none;
            stroke: white;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .cc-info h3 {
        margin: 0 0 14px;
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 3rem;
        line-height: 1.1;
        color: white;
    }

    .cc-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 14px;
    }

        .cc-tags span {
            padding: 5px 16px;
            border: 2px solid var(--cc-blue);
            border-radius: 999px;
            background: rgba(10, 20, 55, 0.6);
            font-family: 'Roboto Condensed', Arial, sans-serif;
            font-weight: 700;
            font-size: 0.9rem;
            text-transform: uppercase;
            color: white;
        }

    .cc-info p {
        max-width: 34em;
        margin: 0 0 24px;
        font-size: 1.1rem;
        line-height: 1.5;
        color: white;
    }

    /* Footer */
    .cc-footer {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
    }

    .cc-source {
        color: var(--cc-gold);
        font-size: 0.85rem;
        font-weight: 500;
    }

    .cc-buttons {
        display: flex;
        gap: 14px;
    }

    .cc-learn {
        padding: 11px 26px;
        border: 2px solid #e8e8e8;
        border-radius: 6px;
        background: rgba(0, 0, 0, 0.35);
        color: white;
        text-decoration: none;
        font-family: 'Roboto Condensed', Arial, sans-serif;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .cc-learn:hover {
            background: rgba(255, 255, 255, 0.15);
        }

    .cc-select {
        --a: 12px;
        padding: 2px;
        border: none;
        cursor: pointer;
        background: var(--cc-gold);
        clip-path: polygon(0 0, calc(100% - var(--a)) 0, 100% 50%, calc(100% - var(--a)) 100%, 0 100%);
        border-radius: 6px 0 0 6px;
    }

        .cc-select span {
            --a: 10px;
            display: block;
            padding: 9px 32px 9px 26px;
            background: var(--cc-navy);
            color: white;
            font-family: 'Roboto Condensed', Arial, sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            clip-path: polygon(0 0, calc(100% - var(--a)) 0, 100% 50%, calc(100% - var(--a)) 100%, 0 100%);
        }

        .cc-select:hover span {
            background: #2a2514;
        }

    .cc-class.selected .cc-select span {
        background: var(--cc-gold);
        color: var(--cc-navy);
    }

    .cc-learn:focus-visible,
    .cc-select:focus-visible {
        outline: 3px solid var(--cc-red);
        outline-offset: 3px;
    }

    /* Create button */
    .cc-actions {
        margin-top: 40px;
        text-align: center;
    }

    .cc-create {
        padding: 14px 56px;
        cursor: pointer;
        background: var(--cc-red);
        color: white;
        border: none;
        border-radius: 4px;
        font-family: 'Roboto Condensed', Arial, sans-serif;
        font-weight: 700;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .cc-create:hover {
            background: var(--cc-red-dark);
        }

    .cc-message {
        margin-top: 16px;
        color: var(--cc-muted);
        min-height: 1.5em;
    }

    @@media (max-width: 600px) {
        .cc-art {
            padding: 24px 20px 20px;
            background-position: 70% center;
        }

        .cc-info h3 {
            font-size: 2.2rem;
        }

        .cc-footer {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
