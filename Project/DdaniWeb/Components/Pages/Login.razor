@page "/login"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager


<div class="signup-container">

    <div class="signup-picture">
        <img src="resources/signupPic.jpg" alt="Fantasy picture" />
    </div>

    <div class="signup-right">
        <div class="signup-form">
            <h3>Login</h3>

            <div>
                <label>Username:</label>
                <input type="text" @bind="UserName" />
            </div>

            <div>
                <label>Password:</label>
                <input type="password" @bind="UserPassword" />
            </div>

            <button @onclick="Login_T">Login</button>
            dont have an account create one -> <a href="/signup">create account</a>
            <p>@s</p>
        </div>
    </div>

</div>

<style>
    .signup-container {
        display: flex;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        margin: 0;
        padding: 0;
        z-index: 1000;
        background: white;
    }

    .signup-picture {
        width: 30%;
        height: 100%;
        flex-shrink: 0;
        overflow: hidden;
    }

        .signup-picture img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .signup-right {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
        box-sizing: border-box;
    }

    .signup-form {
        width: 100%;
        max-width: 380px;
        display: flex;
        flex-direction: column;
    }

        .signup-form h3 {
            margin-bottom: 30px;
            text-align: center;
        }

        .signup-form div {
            margin-bottom: 20px;
        }

        .signup-form label {
            display: block;
            margin-bottom: 8px;
        }

        .signup-form input {
            width: 100%;
            padding: 12px;
            box-sizing: border-box;
        }

        .signup-form button {
            margin-top: 10px;
            padding: 12px;
            cursor: pointer;
        }

        .signup-form p {
            text-align: center;
            margin-top: 15px;
        }

    @@media (max-width: 700px) {
        .signup-container {
            flex-direction: column;
            overflow-y: auto;
        }

        .signup-picture {
            width: 70%;
            height: 40vh;
        }

        .signup-right {
            width: 100%;
            padding: 30px;
        }
    }
</style>

@code {
    HttpClient Http = new HttpClient();


    private string UserName;
    private string UserPassword;
    private string s;

    private string loginAPI = "https://localhost:7105/api/UsersDB/Login";

    private async Task Login_T()
    {   
        var user = new
        {
            username = UserName,
            UserPassword = UserPassword,
            UserEmail = "Sdsd",
            UserRole = "User"
        };


        try
        {
            var response = await Http.PostAsJsonAsync(loginAPI,user);

            if (response.IsSuccessStatusCode)
            {
                List<int> result = await response.Content.ReadFromJsonAsync<List<int>>();



                if (result[0] == 1 || result[0] == 2)
                {
                    await MySession.SetAsync("data", new string[] { result[1].ToString(), UserName });

                    var test = await MySession.GetAsync<string[]>("data");

                    Console.WriteLine("LOGIN TEST:");
                    Console.WriteLine(test.Success);
                    Console.WriteLine(test.Value?[0]);
                    Console.WriteLine(test.Value?[1]);

                    if (result[0] == 2)
                    { navigationManager.NavigateTo("/homeA"); Console.WriteLine("admin"); return; }


                    navigationManager.NavigateTo("/");
                }
                else
                {
                    s = "Incorrect username or password";
                }
            }
            else
            {
                s = "Server error: " + response.StatusCode;
            }
        }
        catch (Exception ex)
        {
            s = $"Request failed: {ex.Message}";
        }
    }

    private async Task SendSign()
    { navigationManager.NavigateTo("SignUp"); }
}

